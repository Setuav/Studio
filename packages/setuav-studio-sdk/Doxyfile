# Setuav Studio SDK documentation

PROJECT_NAME           = "Setuav Studio SDK"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "Public plugin contracts for Setuav Studio"
PROJECT_LOGO           = ../../src/setuav_studio/assets/icons/studio.png

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
PYTHON_DOCSTRING       = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/index.md

# The API reference is generated from the public SDK modules only.
INPUT                  = docs/index.md \
                         src/setuav_studio_sdk
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src
SHOW_FILES             = NO
SHOW_NAMESPACES        = NO
SHOW_USED_FILES        = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
INTERNAL_DOCS          = NO
EXCLUDE_SYMBOLS        = "_*"

SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = docs/sdk.css
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = NO
DISABLE_INDEX          = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
