{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/transform.schema.json",
  "title": "Parent-relative Transform",
  "description": "SETUAV_BODY uses +X aft, +Y right, +Z up. Rotations are degrees and compose as Rz(yaw) * Ry(pitch) * Rx(roll).",
  "type": "object",
  "properties": {
    "position": {
      "type": "object",
      "description": "Translation in millimetres.",
      "properties": {
        "x": { "type": "number", "default": 0, "x-setuav-unit": "mm" },
        "y": { "type": "number", "default": 0, "x-setuav-unit": "mm" },
        "z": { "type": "number", "default": 0, "x-setuav-unit": "mm" }
      },
      "additionalProperties": false
    },
    "rotation": {
      "type": "object",
      "description": "Euler angles in degrees, composed in fixed Z-Y-X order.",
      "properties": {
        "roll": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
        "pitch": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
        "yaw": { "type": "number", "default": 0, "x-setuav-unit": "deg" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
