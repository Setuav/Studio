{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/component.schema.json",
  "title": "Setuav Component",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "kind": { "type": "string", "default": "component" },
    "id": { "$ref": "definitions.schema.json#/$defs/localId" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "$ref": "definitions.schema.json#/$defs/typedId" },
    "source": { "$ref": "definitions.schema.json#/$defs/localId" },
    "derivation": {
      "oneOf": [
        { "type": "string" },
        { "type": "object" }
      ]
    },
    "parameter_overrides": { "type": "object" },
    "description": { "type": "string" },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "mass": { "type": "number", "minimum": 0 },
    "parent": {
      "oneOf": [
        { "$ref": "definitions.schema.json#/$defs/localId" },
        { "type": "null" }
      ],
      "default": null
    },
    "transform": { "$ref": "transform.schema.json" },
    "parameters": {
      "type": "object",
      "description": "Validated by the component type's plugin schema."
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
