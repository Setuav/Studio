{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/project.schema.json",
  "title": "Setuav Project 2.0",
  "type": "object",
  "required": [
    "name",
    "plugins",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "plugin-requirement.schema.json"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "component.schema.json"
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "$ref": "assembly.schema.json"
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      }
    },
    "configurations": {
      "type": "array"
    },
    "driver_groups": {
      "type": "array"
    },
    "parameter_relations": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "analysis": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
