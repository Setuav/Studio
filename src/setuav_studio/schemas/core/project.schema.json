{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/project.schema.json",
  "title": "Setuav Project 2.0",
  "type": "object",
  "required": [
    "name",
    "plugins",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "plugin-requirement.schema.json"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "component.schema.json"
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "$ref": "assembly.schema.json"
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tag"
        ],
        "properties": {
          "id": {
            "$ref": "definitions.schema.json#/$defs/localId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "parameter_overrides": {
            "type": "object"
          },
          "is_default": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "expression",
          "message"
        ],
        "properties": {
          "id": {
            "$ref": "definitions.schema.json#/$defs/localId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "driver_groups": {
      "type": "array"
    },
    "parameter_relations": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "analysis": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
