{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/definitions.schema.json",
  "title": "Setuav Core Definitions",
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Stable, human-readable identifier unique within its project collection."
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "examples": ["org.setuav.core"]
    },
    "typedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+:[a-z][a-z0-9._-]*$",
      "examples": ["org.setuav.core:lifting-surface"]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "semverRange": {
      "type": "string",
      "pattern": "^(?:[~^]|>=?|<=?)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/pluginId" },
      "additionalProperties": { "type": "object" }
    }
  }
}
