{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/core/plugin-requirement.schema.json",
  "title": "Plugin Requirement",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": { "$ref": "definitions.schema.json#/$defs/pluginId" },
    "version": { "$ref": "definitions.schema.json#/$defs/semverRange" },
    "optional": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
