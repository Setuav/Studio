{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.weight-balance/extensions/component.schema.json",
  "title": "Setuav Weight & Balance Component Extension",
  "type": "object",
  "properties": {
    "mass_source": {
      "type": "string",
      "enum": ["declared", "catalog", "estimated", "derived"]
    },
    "symmetry_mode": {
      "type": "string",
      "enum": ["pair", "single"],
      "default": "pair"
    },
    "local_cg_mm": {
      "type": "object",
      "properties": {
        "x": {"type": "number", "x-setuav-unit": "mm"},
        "y": {"type": "number", "x-setuav-unit": "mm"},
        "z": {"type": "number", "x-setuav-unit": "mm"}
      },
      "additionalProperties": false
    },
    "inertia_kg_m2": {
      "type": "object",
      "properties": {
        "ixx": {"type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2"},
        "iyy": {"type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2"},
        "izz": {"type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2"},
        "ixy": {"type": "number", "x-setuav-unit": "kg*m^2"},
        "ixz": {"type": "number", "x-setuav-unit": "kg*m^2"},
        "iyz": {"type": "number", "x-setuav-unit": "kg*m^2"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
