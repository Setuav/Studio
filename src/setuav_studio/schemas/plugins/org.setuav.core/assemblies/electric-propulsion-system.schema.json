{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/assemblies/electric-propulsion-system.schema.json",
  "title": "Electric Propulsion System Members",
  "$defs": {
    "componentId": {
      "$ref": "https://schemas.setuav.org/core/definitions.schema.json#/$defs/localId"
    },
    "componentList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/componentId" }
    }
  },
  "type": "object",
  "required": ["battery", "controllers", "motors", "propulsors"],
  "properties": {
    "battery": { "$ref": "#/$defs/componentId" },
    "controllers": { "$ref": "#/$defs/componentList" },
    "motors": { "$ref": "#/$defs/componentList" },
    "propulsors": { "$ref": "#/$defs/componentList" }
  },
  "additionalProperties": false
}
