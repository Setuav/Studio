{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/components/motor.schema.json",
  "title": "Electric Motor Parameters",
  "type": "object",
  "required": ["kv", "max_current"],
  "properties": {
    "kv": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "rpm/V" },
    "resistance": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "ohm" },
    "no_load_current": { "type": "number", "minimum": 0, "x-setuav-unit": "A" },
    "max_current": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "A" },
    "max_power": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "W" },
    "mass": { "type": "number", "minimum": 0, "x-setuav-unit": "g" }
  },
  "additionalProperties": false
}
