{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/components/battery.schema.json",
  "title": "Battery Parameters (Cell & Pack)",
  "type": "object",
  "required": ["cell_count", "capacity", "nominal_voltage"],
  "properties": {
    "cell_count": { "type": "integer", "minimum": 1 },
    "parallel_count": { "type": "integer", "minimum": 1, "default": 1 },
    "capacity": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "mAh" },
    "nominal_voltage": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "V" },
    "internal_resistance": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "ohm" },
    "packaging_mass": { "type": "number", "minimum": 0, "x-setuav-unit": "g" },
    "chemistry": { "type": "string" },
    "cell_capacity": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "mAh" },
    "cell_nominal_voltage": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "V" },
    "cell_max_voltage": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "V" },
    "cell_min_voltage": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "V" },
    "cell_resistance": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "ohm" },
    "cell_mass": { "type": "number", "minimum": 0, "x-setuav-unit": "g" },
    "max_discharge": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "1" },
    "burst_discharge": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "1" },
    "mass": { "type": "number", "minimum": 0, "x-setuav-unit": "g" }
  },
  "additionalProperties": false
}
