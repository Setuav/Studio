{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/components/fuselage.schema.json",
  "title": "Fuselage Parameters",
  "$defs": {
    "position": {
      "type": "object",
      "required": ["x"],
      "properties": {
        "x": { "type": "number", "x-setuav-unit": "mm" },
        "y": { "type": "number", "default": 0, "x-setuav-unit": "mm" },
        "z": { "type": "number", "default": 0, "x-setuav-unit": "mm" }
      },
      "additionalProperties": false
    },
    "rotation": {
      "description": "Section rotation. x/y/z is canonical; roll/pitch/yaw is accepted for projects created by earlier Studio builds.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "x": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
            "y": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
            "z": { "type": "number", "default": 0, "x-setuav-unit": "deg" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "roll": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
            "pitch": { "type": "number", "default": 0, "x-setuav-unit": "deg" },
            "yaw": { "type": "number", "default": 0, "x-setuav-unit": "deg" }
          },
          "additionalProperties": false
        }
      ]
    },
    "transitionMethod": {
      "enum": ["auto", "smooth", "ruled"],
      "description": "Cross-section transition intent. Smooth creates one constrained skin, ruled linearly connects corresponding profile parameters, and auto delegates the choice to the geometry engine."
    },
    "loft": {
      "type": "object",
      "properties": {
        "method": { "$ref": "#/$defs/transitionMethod", "default": "smooth" },
        "parameterization": {
          "enum": ["uniform", "chord_length", "centripetal"],
          "default": "centripetal",
          "description": "Longitudinal skin parameter spacing derived from section array order and section-origin distances."
        },
        "profile_correspondence": {
          "const": "cardinal_quadrants",
          "default": "cardinal_quadrants",
          "description": "Match right, bottom, left and top landmarks, then map each intervening profile arc by normalized arc length."
        }
      },
      "additionalProperties": false
    },
    "skinControl": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "number",
          "x-setuav-unit": "deg",
          "description": "Longitudinal tangent angle relative to the section frame."
        },
        "slew": {
          "type": "number",
          "x-setuav-unit": "deg",
          "description": "Lateral rotation of the longitudinal tangent."
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "description": "Dimensionless tangent magnitude relative to the section characteristic size."
        },
        "curvature_strength": {
          "type": "number",
          "description": "Dimensionless signed second-derivative magnitude relative to the section characteristic size."
        }
      },
      "additionalProperties": false
    },
    "skinSide": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "number",
          "x-setuav-unit": "deg"
        },
        "slew": {
          "type": "number",
          "x-setuav-unit": "deg"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "curvature_strength": { "type": "number" },
        "regions": {
          "type": "object",
          "properties": {
            "top": { "$ref": "#/$defs/skinControl" },
            "right": { "$ref": "#/$defs/skinControl" },
            "bottom": { "$ref": "#/$defs/skinControl" },
            "left": { "$ref": "#/$defs/skinControl" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Controls for one longitudinal side of a section. Region values override the side-wide values; omitted values are automatic."
    },
    "skin": {
      "type": "object",
      "properties": {
        "continuity": {
          "enum": ["position", "tangent", "curvature"],
          "default": "curvature",
          "description": "Requested geometric continuity across this section."
        },
        "symmetry": {
          "enum": ["all", "top_bottom", "left_right", "none"],
          "default": "all",
          "description": "How top/right/bottom/left control values are coupled."
        },
        "incoming": {
          "$ref": "#/$defs/skinSide",
          "description": "Controls for the interval ending at this section in array order."
        },
        "outgoing": {
          "$ref": "#/$defs/skinSide",
          "description": "Controls for the interval starting at this section in array order."
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "diameter"],
          "properties": {
            "type": { "const": "circle" },
            "diameter": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "properties": {
            "type": { "const": "ellipse" },
            "width": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" },
            "height": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "properties": {
            "type": { "const": "rectangle" },
            "width": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" },
            "height": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" },
            "corner_radius": { "type": "number", "minimum": 0, "default": 0, "x-setuav-unit": "mm" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "top_width", "bottom_width", "height"],
          "properties": {
            "type": { "const": "trapezoid" },
            "top_width": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" },
            "bottom_width": { "type": "number", "minimum": 0, "x-setuav-unit": "mm" },
            "height": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "mm" },
            "corner_radius": { "type": "number", "minimum": 0, "default": 0, "x-setuav-unit": "mm" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "base_width", "height", "orientation"],
          "properties": {
            "type": { "const": "triangle" },
            "base_width": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "mm" },
            "height": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "mm" },
            "orientation": { "enum": ["up", "down"], "default": "up" },
            "corner_radius": { "type": "number", "minimum": 0, "default": 0, "x-setuav-unit": "mm" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "vertices"],
          "properties": {
            "type": { "const": "polygon" },
            "vertices": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "description": "Ordered vertices in the local Y-Z section plane. The final edge closes implicitly.",
              "items": {
                "type": "object",
                "required": ["y", "z"],
                "properties": {
                  "y": { "type": "number", "x-setuav-unit": "mm" },
                  "z": { "type": "number", "x-setuav-unit": "mm" },
                  "radius": { "type": "number", "minimum": 0, "default": 0, "x-setuav-unit": "mm" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["position", "profile"],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "rotation": { "$ref": "#/$defs/rotation" },
        "profile": { "$ref": "#/$defs/profile" },
        "skin": { "$ref": "#/$defs/skin" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["geometry"],
  "properties": {
    "mass": { "type": "number", "minimum": 0, "x-setuav-unit": "g" },
    "geometry": {
      "type": "object",
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tag", "sections"],
            "properties": {
              "tag": { "type": "string", "minLength": 1 },
              "loft": { "$ref": "#/$defs/loft" },
              "sections": {
                "type": "array",
                "minItems": 2,
                "items": { "$ref": "#/$defs/section" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
