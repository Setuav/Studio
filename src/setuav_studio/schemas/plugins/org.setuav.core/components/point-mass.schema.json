{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/components/point-mass.schema.json",
  "title": "Point Mass Parameters",
  "type": "object",
  "required": ["mass"],
  "properties": {
    "mass": { "type": "number", "exclusiveMinimum": 0, "x-setuav-unit": "g" },
    "inertia": {
      "type": "object",
      "properties": {
        "ixx": { "type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2" },
        "iyy": { "type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2" },
        "izz": { "type": "number", "minimum": 0, "x-setuav-unit": "kg*m^2" },
        "ixy": { "type": "number", "x-setuav-unit": "kg*m^2" },
        "ixz": { "type": "number", "x-setuav-unit": "kg*m^2" },
        "iyz": { "type": "number", "x-setuav-unit": "kg*m^2" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
