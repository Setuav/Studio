{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.setuav.org/plugins/org.setuav.core/extensions/physical.schema.json",
  "title": "SETUAV Physical Envelope Extension",
  "type": "object",
  "properties": {
    "envelope": {
      "type": "object",
      "required": ["shape", "size_mm"],
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["box"]
        },
        "size_mm": {
          "description": "Full envelope dimensions along the component local X/Y/Z axes.",
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number", "minimum": 0, "x-setuav-unit": "mm"},
            "y": {"type": "number", "minimum": 0, "x-setuav-unit": "mm"},
            "z": {"type": "number", "minimum": 0, "x-setuav-unit": "mm"}
          },
          "additionalProperties": false
        },
        "offset_mm": {
          "description": "Envelope center offset relative to the component local origin.",
          "type": "object",
          "properties": {
            "x": {"type": "number", "x-setuav-unit": "mm"},
            "y": {"type": "number", "x-setuav-unit": "mm"},
            "z": {"type": "number", "x-setuav-unit": "mm"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
