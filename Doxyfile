# Setuav Studio Plugin SDK documentation

PROJECT_NAME           = "Setuav Studio Plugin SDK"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Public Python API for third-party Setuav Studio plugins"
PROJECT_LOGO           = src/setuav_studio/assets/icons/studio.png

OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

OPTIMIZE_OUTPUT_JAVA   = YES
PYTHON_DOCSTRING       = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/api/index.md

INPUT                  = docs/api/index.md \
                         src/setuav_studio/sdk \
                         src/setuav_studio/plugin_system.py \
                         src/setuav_studio/component_editor.py \
                         src/setuav_studio/project.py
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src
SHOW_FILES             = NO
SHOW_NAMESPACES        = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
EXCLUDE_SYMBOLS        = "_*" \
                         _ComponentEditCommand \
                         _ProjectEditCommand \
                         PluginLoadIssue \
                         PluginManager \
                         ProjectOpenError \
                         ProjectSaveError \
                         open_project \
                         save_project

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = docs/doxygen/html
HTML_EXTRA_STYLESHEET  = docs/api/sdk.css
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
